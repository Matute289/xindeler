// Default atmosphere profile (BL-82 EM-2.4, spec §5.4).
//
// Schema: `AtmosphereProfile` in bevy/xindeler-oracle-host/src/atmosphere.rs.
// These values MUST equal `AtmosphereProfile::default()` (unit-tested there):
// the camera/light rigs spawn from the Rust defaults, so the first load of
// this file is a visual no-op. Edit it while the client runs to watch the
// atmosphere animate (hot reload via bevy's file_watcher).
(
    // Distance-fog extinction density for `FogFalloff::ExponentialSquared`
    // (BL-82 EM-3.11f re-tune — clear near/mid field, ~97.5% fogged by the
    // far-mesh's ~288m cutout hole; see AtmosphereProfile::default()'s doc
    // comment for the full rationale + curve-shape reasoning).
    fog_density: 0.00667,
    // sRGB fog color (brightened/desaturated in EM-3.11b to match the
    // physically-based Atmosphere sky's horizon haze more closely).
    fog_color: (0.66, 0.73, 0.81),
    // sRGB sky/void color (world ClearColor; bevy stock = srgb_u8(43, 44, 47)).
    sky_color: (0.168627, 0.172549, 0.184314),
    // Density factor for placed volumetric FogVolumes (engine extension).
    fog_volume_density: 0.15,
    // VolumetricFog ambient intensity on the camera.
    ambient_light_intensity: 0.1,
    // Sun illuminance, lux (physical raw sunlight; engine extension).
    sun_illuminance: 130000.0,
    // Uniform sky ambient -> GlobalAmbientLight (engine extension, EM-3.4):
    // sRGB color + brightness in cd/m². The indirect floor vertex AO acts on.
    ambient_sky: (
        color: (0.75, 0.85, 1.0),
        brightness: 6000.0,
    ),
    // Placeholder weather tag: None | Rain | Storm (data only for now).
    weather_effect: None,
    // Some(hour 0.0..24.0) freezes the day/night cycle; None = normal cycle.
    time_lock: None,
    // Seconds over which a change TO this profile interpolates.
    transition_secs: 5.0,
)
